{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AUN-PN/pr-dashboard-mcp/blob/main/protocol/pr-work-1.schema.json",
  "title": "pr-work/1 record",
  "type": "object",
  "required": ["protocol", "repo", "number", "status", "actor", "updatedAt"],
  "properties": {
    "protocol": { "const": "pr-work/1" },
    "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
    "number": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["working", "paused", "done"] },
    "actor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "label": { "type": "string", "maxLength": 80 },
    "note": { "type": "string", "maxLength": 280 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
