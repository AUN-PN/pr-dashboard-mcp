{
  "mcpServers": {
    "pr-dashboard": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.js"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${user_config.github_token}",
        "GITHUB_HOST": "${user_config.github_host}",
        "WATCHED_REPOS": "${user_config.watched_repos}"
      }
    }
  }
}
